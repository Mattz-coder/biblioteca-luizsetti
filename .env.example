# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# NUNCA suba o arquivo ".env" de verdade para o GitHub (ele fica no .gitignore).

PORT=3000
NODE_ENV=development

# ---- Conexao com o PostgreSQL ----
# Em desenvolvimento local (Postgres na sua maquina), pode deixar como esta.
#
# Para usar o Supabase: va em Project Settings > Database > Connection
# parameters no painel do Supabase e copie os valores de host, porta,
# database, user e password para ca. Tambem defina PGSSLMODE=require.
PGHOST=localhost
PGPORT=5432
PGDATABASE=biblioteca_virtual
PGUSER=postgres
PGPASSWORD=troque_esta_senha
PGSSLMODE=disable

# Segredo usado para assinar o cookie/token de sessao (troque por um
# valor aleatorio e dificil de adivinhar em producao)
SESSION_SECRET=troque_este_segredo_tambem

SEED_ADMIN_CPF=12345678900
SEED_ADMIN_NOME=Funcionario Teste
SEED_ADMIN_SENHA=senha123